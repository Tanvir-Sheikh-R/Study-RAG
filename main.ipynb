   "source": [
    "import pytesseract\n",
    "from pdf2image import convert_from_path\n",
    "\n",
    "pages = convert_from_path(\"file.pdf\", dpi=300)\n",
    "for i, page in enumerate(pages):\n",
    "    text = pytesseract.image_to_string(page)\n",
    "    print(f\"--- Page {i+1} ---\\n{text}\")"
   ]
  }
